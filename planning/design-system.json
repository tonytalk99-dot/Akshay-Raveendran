{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Aura Archive Design System",
  "version": "1.0.0",
  "description": "Editorial design tokens and measurements reverse-engineered from reference materials for premium 3D collectible-art showcase.",
  "tokens": {
    "colors": {
      "background": {
        "canvas": "#F4F2EC",
        "canvasAlt": "#ECEAE3",
        "surface": "#FFFFFF",
        "surfaceSubtle": "rgba(255, 255, 255, 0.72)",
        "surfaceDim": "rgba(20, 20, 22, 0.04)"
      },
      "border": {
        "hairline": "#E1DED5",
        "medium": "#C8C4B8",
        "focus": "#18181B"
      },
      "text": {
        "primary": "#121214",
        "secondary": "#575653",
        "muted": "#8A8880",
        "inverse": "#FDFCFA"
      },
      "accent": {
        "charcoal": "#1C1C1F",
        "goldLeaf": "#C5A880",
        "sketchInk": "#2B2A28",
        "activeDot": "#18181B"
      },
      "pbrMaterials": {
        "discBaseMetal": "#D8D9DD",
        "discClearPlastic": "rgba(240, 242, 245, 0.35)",
        "discRimSpecular": "#FFFFFF",
        "shadowAmbient": "rgba(26, 24, 20, 0.12)"
      }
    },
    "typography": {
      "fontFamilies": {
        "displaySerif": "Cinzel, 'Playfair Display', Didot, 'Bodoni MT', Georgia, serif",
        "editorialSerif": "'Cormorant Garamond', 'EB Garamond', Georgia, serif",
        "interfaceSans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', 'SF Mono', monospace"
      },
      "scale": {
        "displayHero": {
          "fontSize": "48px",
          "lineHeight": "1.08",
          "letterSpacing": "-0.02em",
          "fontWeight": "400",
          "textTransform": "uppercase"
        },
        "displayMobile": {
          "fontSize": "32px",
          "lineHeight": "1.12",
          "letterSpacing": "-0.015em",
          "fontWeight": "400",
          "textTransform": "uppercase"
        },
        "headlineSection": {
          "fontSize": "24px",
          "lineHeight": "1.25",
          "letterSpacing": "-0.01em",
          "fontWeight": "400"
        },
        "quoteTitle": {
          "fontSize": "19px",
          "lineHeight": "1.3",
          "letterSpacing": "-0.01em",
          "fontWeight": "400",
          "textTransform": "uppercase"
        },
        "metaLabel": {
          "fontSize": "11px",
          "lineHeight": "1.3",
          "letterSpacing": "0.08em",
          "fontWeight": "500",
          "textTransform": "uppercase"
        },
        "metaValue": {
          "fontSize": "14px",
          "lineHeight": "1.45",
          "letterSpacing": "0.01em",
          "fontWeight": "400"
        },
        "body": {
          "fontSize": "15px",
          "lineHeight": "1.6",
          "letterSpacing": "0em",
          "fontWeight": "400"
        },
        "badge": {
          "fontSize": "12px",
          "lineHeight": "1.2",
          "letterSpacing": "0.06em",
          "fontWeight": "600",
          "textTransform": "uppercase"
        }
      }
    },
    "spacing": {
      "layout": {
        "viewportPaddingX": "56px",
        "viewportPaddingY": "40px",
        "mobilePaddingX": "20px",
        "mobilePaddingY": "24px",
        "headerHeight": "64px",
        "leftRailWidth": "340px",
        "bottomRailHeight": "140px"
      },
      "scales": {
        "xs": "4px",
        "sm": "8px",
        "md": "16px",
        "lg": "24px",
        "xl": "32px",
        "xxl": "48px",
        "section": "72px"
      }
    },
    "motion": {
      "easings": {
        "editorialSmooth": "cubic-bezier(0.16, 1, 0.3, 1)",
        "magneticSpring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
        "gentleSettle": "cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "durations": {
        "instant": "150ms",
        "fast": "250ms",
        "standard": "450ms",
        "deliberate": "750ms",
        "splineTravel": "1200ms"
      }
    },
    "threeD": {
      "camera": {
        "fov": 45,
        "near": 0.1,
        "far": 1000,
        "position": [0, 0, 7.8],
        "target": [0, 0, 0]
      },
      "discSpecs": {
        "radius": 1.95,
        "innerHoleRadius": 0.38,
        "clearHubRadius": 0.65,
        "thickness": 0.04,
        "segments": 128
      },
      "lighting": {
        "ambientIntensity": 0.75,
        "keyDirectional": {
          "position": [4, 6, 8],
          "intensity": 1.4,
          "color": "#FFFDF8"
        },
        "fillDirectional": {
          "position": [-5, -2, 4],
          "intensity": 0.5,
          "color": "#D8E2F0"
        },
        "rimLight": {
          "position": [0, 4, -4],
          "intensity": 0.9,
          "color": "#FFFFFF"
        }
      }
    },
    "responsiveBreakpoints": {
      "mobile": "640px",
      "tablet": "1024px",
      "desktop": "1440px",
      "wide": "1920px"
    }
  }
}
